{
  "name": "shared-testing-utils",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/testing-utils/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:testing"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/shared/testing-utils/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/shared/testing-utils"],
      "options": {
        "jestConfig": "libs/shared/testing-utils/jest.config.ts",
        "passWithNoTests": true
      }
    }
  }
}
